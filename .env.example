APP_ENV=dev
DATABASE_URL=postgresql+psycopg://vinea:vinea@localhost:5432/vinea
REDIS_URL=redis://localhost:6379/0
# Required outside dev (ADR-03). Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me
COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:3000
# The e2e fixture credential: `app.scripts.seed_e2e` hashes it and the Playwright suite
# signs in with it. No literal exists in the tree for either side to fall back to, so set
# it before `make db-reset` or `npm run e2e`. Generate with: openssl rand -base64 24
E2E_PASSWORD=
# E2E ONLY, and normally set by docker-compose.e2e.yml rather than here. The non-production
# mail stub appends every message to this file so the Playwright suite can read the one-time
# tokens it needs to follow a reset or invitation link. Leave it unset for ordinary running:
# production refuses to start if it is set at all.
# EMAIL_OUTBOX_FILE=/app/.e2e-outbox.jsonl
