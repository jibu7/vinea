{
  "extends": "next/core-web-vitals",
  "rules": {
    "react/jsx-no-literals": [
      "error",
      {
        "noStrings": true,
        "ignoreProps": true
      }
    ],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "JSXAttribute[name.name=/^(placeholder|title|description|label|aria-label)$/] > Literal[value=/\\S/]",
        "message": "User-visible attribute copy must come from next-intl: use placeholder={t(\"…\")}, not placeholder=\"…\"."
      },
      {
        "selector": "JSXAttribute[name.name=/^(placeholder|title|description|label|aria-label)$/] > JSXExpressionContainer > Literal[value=/\\S/]",
        "message": "User-visible attribute copy must come from next-intl: use placeholder={t(\"…\")}, not placeholder={\"…\"}."
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/app/design/**/*.tsx"],
      "rules": {
        "react/jsx-no-literals": "off",
        "no-restricted-syntax": "off"
      }
    }
  ]
}
