# Fixture credentials for the disposable e2e tenant.
#
# One source of truth, read from the environment by everything that needs it rather than
# repeated as literals in test code:
#   - `backend/app/scripts/seed_e2e.py`, via docker-compose's `env_file` on the backend service
#   - the Playwright suite, via the loader at the top of `frontend/playwright.config.ts`
#   - `frontend/scripts/capture-p4-screens.ts`
#
# These are not secrets. They address a throwaway tenant that only exists in a development or
# CI database, and `make db-reset` recreates it from nothing. Anything already set in the
# environment wins over this file, so CI or a developer can point the suite elsewhere.
E2E_PRIMARY_EMAIL=e2e.primary@vinea.example
E2E_SECONDARY_EMAIL=e2e.secondary@vinea.example
E2E_READONLY_EMAIL=e2e.readonly@vinea.example
E2E_SALES_EMAIL=e2e.sales@vinea.example
E2E_PASSWORD=E2E-Sup3rSecret!1
