# Playwright writes these relative to whatever cwd it was launched from, so the rules are
# path-independent: a run started from backend/ once left a test-results/ there, and a
# frontend-only rule does not catch it.
playwright-report/
test-results/
# The e2e mail catcher (docker-compose.e2e.yml). One-time tokens in plain text — never
# committed, and never written at all unless EMAIL_OUTBOX_FILE is set.
backend/.e2e-outbox.jsonl

